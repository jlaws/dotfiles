# =============================================================================
# Git - the same subcommands as the Claude Code allow list (Bash(git <subcmd> *));
# clone and clean are in neither
# =============================================================================

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "branch", "blame",
                        "ls-files", "rev-parse", "remote", "tag", "worktree"]],
    decision = "allow",
    justification = "Read-only git inspection is safe and common during code work.",
    match = [
        "git status",
        "git diff",
        "git log --oneline",
        "git show HEAD~1",
        "git branch -a",
        "git blame src/main.py",
        "git ls-files",
        "git rev-parse HEAD",
        "git remote -v",
        "git tag -l",
        "git worktree list",
    ],
    not_match = [],
)

prefix_rule(
    pattern = ["git", ["add", "commit", "stash", "fetch", "pull", "checkout",
                        "switch", "merge", "rebase", "cherry-pick", "restore",
                        "rm", "mv", "reset"]],
    decision = "allow",
    justification = "Local git write operations allowed to match Claude Code permissions.",
    match = [
        "git add -A",
        "git commit -m 'fix typo'",
        "git stash pop",
        "git fetch origin",
        "git pull --rebase",
        "git checkout -b feature/test",
        "git switch main",
        "git merge feature/test",
        "git rebase main",
        "git cherry-pick abc123",
        "git restore --staged file.txt",
        "git rm old-file.txt",
        "git mv old.txt new.txt",
        "git reset --soft HEAD~1",
    ],
    not_match = [],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "allow",
    justification = "Git push allowed to match Claude Code permissions.",
    match = [
        "git push",
        "git push -u origin feature/test",
    ],
    not_match = [],
)

# =============================================================================
# GitHub CLI - read and PR workflow only (matches Claude Code: Bash(gh pr view *), ...)
# =============================================================================

prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "diff", "checks", "create", "edit"]],
    decision = "allow",
    justification = "Pull request inspection and creation allowed to match Claude Code permissions.",
    match = [
        "gh pr view 123",
        "gh pr list",
        "gh pr diff 123",
        "gh pr checks 123",
        "gh pr create --title Test --body Body",
        "gh pr edit 123 --title Test",
    ],
    not_match = [
        "gh pr merge 123",
        "gh api user",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", ["view", "list"]],
    decision = "allow",
    justification = "Issue inspection allowed to match Claude Code permissions.",
    match = [
        "gh issue view 12",
        "gh issue list",
    ],
    not_match = [
        "gh issue close 12",
        "gh issue comment 12 --body hi",
    ],
)

prefix_rule(
    pattern = ["gh", "run", ["list", "view"]],
    decision = "allow",
    justification = "Workflow run inspection allowed to match Claude Code permissions.",
    match = [
        "gh run list",
        "gh run view 123",
    ],
    not_match = [
        "gh api user",
    ],
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
    justification = "Repository inspection allowed to match Claude Code permissions.",
    match = [
        "gh repo view",
        "gh repo view owner/repo",
    ],
    not_match = [
        "gh api user",
    ],
)

prefix_rule(
    pattern = ["agent-browser"],
    decision = "allow",
    justification = "AGENTS.md names the agent-browser CLI as the fetch tool for JS-rendered and auth-walled pages; allowed to match Claude Code permissions.",
    match = [
        "agent-browser read https://example.com",
        "agent-browser open https://example.com",
        "agent-browser install",
        "agent-browser skills get core",
    ],
    not_match = [],
)

# =============================================================================
# File utilities (matches Claude Code: cat, head, tail, sed, etc.)
# =============================================================================

prefix_rule(
    pattern = [["cat", "head", "tail", "sed", "grep", "ls",
                 "wc", "diff", "sort", "uniq", "tr",
                 "jq", "file", "stat", "realpath", "dirname", "basename"]],
    decision = "allow",
    justification = "Read/transform utilities are safe for code inspection.",
    match = [
        "cat README.md",
        "head -20 src/main.py",
        "tail -f app.log",
        "sed 's/foo/bar/g' file.txt",
        "grep -r TODO src/",
        "ls -la",
        "wc -l src/*.py",
        "diff file1.txt file2.txt",
        "sort names.txt",
        "uniq -c sorted.txt",
        "tr '[:upper:]' '[:lower:]'",
        "jq '.data' response.json",
        "file binary.dat",
        "stat README.md",
        "realpath ../config",
        "dirname /path/to/file",
        "basename /path/to/file.txt",
    ],
    not_match = [],
)

prefix_rule(
    pattern = [["mkdir", "touch", "cp", "mv", "echo", "printf"]],
    decision = "allow",
    justification = "File manipulation utilities allowed to match Claude Code permissions.",
    match = [
        "mkdir -p src/new-dir",
        "touch newfile.txt",
        "cp src/a.txt src/b.txt",
        "mv old.txt new.txt",
        "echo 'hello'",
        "printf '%s\n' hello",
    ],
    not_match = [],
)

# =============================================================================
# Node.js / JS tooling (matches Claude Code: npm list, npm audit, tsc, etc.)
# =============================================================================

prefix_rule(
    pattern = ["npm", ["list", "outdated", "audit", "info"]],
    decision = "allow",
    justification = "Read-only npm commands allowed to match Claude Code permissions.",
    match = [
        "npm list",
        "npm outdated",
        "npm audit",
        "npm info express",
    ],
    not_match = [
        "npm install express",
        "npm test",
    ],
)

prefix_rule(
    pattern = ["npm", "audit", "fix"],
    decision = "prompt",
    justification = "npm audit fix runs an install, and its lifecycle scripts, so it needs approval.",
    match = [
        "npm audit fix",
        "npm audit fix --force",
    ],
    not_match = [
        "npm audit",
        "npm audit --json",
    ],
)

prefix_rule(
    pattern = ["tsc"],
    decision = "allow",
    justification = "TypeScript type-check allowed.",
    match = [
        "tsc --noEmit",
    ],
    not_match = [],
)

# =============================================================================
# Swift tooling (matches Claude Code: swiftlint, swiftformat)
# =============================================================================

prefix_rule(
    pattern = [["swiftlint", "swiftformat"]],
    decision = "allow",
    justification = "Swift lint and format tools allowed.",
    match = [
        "swiftlint lint",
        "swiftformat .",
    ],
    not_match = [],
)

# =============================================================================
# System info (matches Claude Code: which, uname, whoami, pwd, date)
# =============================================================================

prefix_rule(
    pattern = [["which", "uname", "whoami", "pwd", "date"]],
    decision = "allow",
    justification = "Read-only system info commands are safe.",
    match = [
        "which python",
        "uname -a",
        "whoami",
        "pwd",
        "date",
    ],
    not_match = [],
)

# =============================================================================
# Package installs - prompt (not auto-allowed in Claude Code either)
# =============================================================================

prefix_rule(
    pattern = [["brew", "npm", "pnpm", "yarn", "uv", "pip"], ["install", "add", "sync"]],
    decision = "prompt",
    justification = "Dependency installation changes the local environment and should be approved.",
    match = [
        "brew install ripgrep",
        "npm install eslint",
        "uv sync",
    ],
    not_match = [
        "brew list",
        "pip show requests",
    ],
)

# =============================================================================
# Denied - sudo, as in the Claude Code Bash deny list. The Claude Read(...) denies have no
# Codex equivalent here; npm audit fix prompts instead of denying (see the npm section)
# =============================================================================

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Privileged execution is never auto-approved.",
    match = [
        "sudo rm -rf /",
        "sudo apt install foo",
    ],
    not_match = [],
)
