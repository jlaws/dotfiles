{
  "permissions": {
    "allow": [
      "Shell(git)",
      "Shell(gh)",
      "Shell(cat)",
      "Shell(head)",
      "Shell(tail)",
      "Shell(sed)",
      "Shell(awk)",
      "Shell(npm)",
      "Shell(npx)",
      "Shell(eslint)",
      "Shell(prettier)",
      "Shell(tsc)",
      "Shell(swiftlint)",
      "Shell(swiftformat)",
      "Shell(which)",
      "Shell(wc)",
      "Shell(mkdir)",
      "Shell(touch)",
      "Shell(cp)",
      "Shell(mv)",
      "Shell(chmod)",
      "Shell(open)",
      "Shell(jq)",
      "Shell(sort)",
      "Shell(uniq)",
      "Shell(tr)",
      "Shell(xargs)",
      "Shell(diff)",
      "Shell(echo)",
      "Shell(printf)",
      "Shell(tee)",
      "Shell(realpath)",
      "Shell(dirname)",
      "Shell(basename)",
      "Shell(file)",
      "Shell(stat)",
      "Shell(uname)",
      "Shell(whoami)",
      "Shell(pwd)",
      "Shell(env)",
      "Shell(date)",
      "Shell(grep)",
      "Shell(ls)"
    ],
    "deny": [
      "Shell(sudo)",
      "Read(.git/config)",
      "Read(.env*)",
      "Read(secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "version": 1,
  "editor": {
    "vimMode": false
  },
  "hasChangedDefaultModel": false,
  "maxMode": false,
  "network": {
    "useHttp1ForAgent": false
  },
  "approvalMode": "allowlist",
  "attribution": {
    "attributeCommitsToAgent": false,
    "attributePRsToAgent": false
  }
}
