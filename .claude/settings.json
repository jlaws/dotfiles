{
  "skillListingBudgetFraction": 0.03,
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git restore *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git worktree *)",
      "Bash(git clone *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(agent-browser *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(npm list *)",
      "Bash(npm outdated *)",
      "Bash(npm audit *)",
      "Bash(npm info *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(tsc *)",
      "Bash(swiftlint *)",
      "Bash(swiftformat *)",
      "Bash(which *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(open *)",
      "Bash(jq *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(xargs *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(tee *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(uname *)",
      "Bash(whoami)",
      "Bash(pwd)",
      "Bash(env)",
      "Bash(date)",
      "Bash(grep:*)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Read(./.git/config)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/log-prompt.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowUnixSockets": [],
      "allowLocalBinding": true
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md"
      }
    }
  },
  "remoteControlAtStartup": true,
  "autoDreamEnabled": true,
  "agentPushNotifEnabled": true
}
