{
  "model": {
    "id": "gemini-3.1-pro-preview"
  },
  "security": {
    "auth": {
      "selectedType": "gemini-api-key"
    }
  },
  "context": {
    "fileFiltering": {
      "respectGitIgnore": false,
      "respectGeminiIgnore": true
    }
  },
  "policy": {
    "path": ".gemini/policies/default.toml"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"SKILL-LOOKUP DISCIPLINE: Before any implementation action, check ~/.agents/skills/ and ~/.agents/references/ for applicable workflows. Load skill-lookup-discipline for full rules.\"}'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.gemini/hooks/lessons-learned.sh"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.gemini/hooks/log-prompt.sh"
          }
        ]
      }
    ]
  }
}